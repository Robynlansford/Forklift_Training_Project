{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tourready-operator",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-11",
  // nodejs_compat is required by @opennextjs/cloudflare; the global_fetch_strictly_public
  // flag makes the Worker's own fetch() behave like a public client, which is what
  // Next's server code expects.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
